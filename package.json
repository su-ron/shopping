{
  "name": "claude-ecommerce-backend",
  "version": "1.0.0",
  "description": "Claude商城后端API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "api": "node server-express.js",
    "api:dev": "nodemon server-express.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run api:dev\"",
    "test:security": "node test-security.js",
    "security:check": "node -e \"require('./config/security').environment.securityCheck()\""
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "ecommerce",
    "api",
    "claude"
  ],
  "author": "Claude商城",
  "license": "MIT"
}
