# 蓝牙耳机专卖网站 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========== 服务器配置 ==========
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ========== 数据库配置 ==========
# 开发环境
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=claude_mall
DB_CONNECTION_LIMIT=10

# 生产环境（覆盖上面的开发配置）
# DB_HOST=your_production_db_host
# DB_PORT=3306
# DB_USER=your_production_db_user
# DB_PASSWORD=your_strong_production_password
# DB_NAME=claude_mall_production
# DB_CONNECTION_LIMIT=20

# ========== JWT认证配置 ==========
JWT_SECRET=your_strong_jwt_secret_key_min_32_chars
JWT_ACCESS_TOKEN_EXPIRES_IN=15m      # 访问令牌过期时间（短）
JWT_REFRESH_TOKEN_EXPIRES_IN=7d      # 刷新令牌过期时间（长）
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret_different_from_access

# ========== 安全配置 ==========
RATE_LIMIT_WINDOW_MS=900000          # 15分钟窗口
RATE_LIMIT_MAX_REQUESTS=100          # 每个IP在窗口期内最大请求数
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5      # 登录尝试次数限制
RATE_LIMIT_LOGIN_WINDOW_MS=900000    # 登录限制窗口（15分钟）

# ========== CORS配置 ==========
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
CORS_CREDENTIALS=true

# ========== 其他配置 ==========
SESSION_SECRET=your_session_secret_key
CSRF_SECRET=your_csrf_secret_key

# ========== 安全提示 ==========
# 1. 所有密钥应该使用强密码生成器生成
# 2. 生产环境不应使用默认值
# 3. 定期轮换密钥
# 4. 不要将 .env 文件提交到版本控制系统